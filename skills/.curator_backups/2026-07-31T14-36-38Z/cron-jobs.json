    {
      "id": "ada277d8d953",
      "name": "\u818f\u65b9\u6708\u5ea6\u7edf\u8ba1\u62a5\u544a",
      "prompt": "\u6267\u884c\u818f\u65b9\u6708\u5ea6\u7edf\u8ba1\u62a5\u544a\u4efb\u52a1\u3002\n\n1. \u67e5\u8be2\u4e0a\u4e2a\u6708\u7684\u8d77\u59cb\u548c\u7ed3\u675f\u65e5\u671f\uff08\u4e0a\u4e2a\u67081\u53f7 00:00 \u5230 \u672c\u67081\u53f7 00:00\uff09\n2. \u6309\u300c\u5bfc\u5165\u65f6\u95f4 (created_at)\u300d\u7edf\u8ba1\u4e0a\u4e2a\u6708\u7684\u818f\u65b9\u6570\u636e\uff1a\n   - \u4e0a\u4f20\u60a3\u8005\u4eba\u6570\uff08\u6309\u59d3\u540d+\u5e74\u9f84+\u7535\u8bdd\u53bb\u91cd\uff09\n   - \u4e0a\u4f20\u603b\u6599\u6570\uff08quantity\u5408\u8ba1\uff09\n   - \u53d1\u653e\u60a3\u8005\u6570\uff08status=\u5df2\u53d6\u6216\u5df2\u90ae\u5bc4\uff0c\u6309\u59d3\u540d+\u5e74\u9f84+\u7535\u8bdd\u53bb\u91cd\uff09\n   - \u53d1\u653e\u6599\u6570\uff08status=\u5df2\u53d6\u6216\u5df2\u90ae\u5bc4\uff0cquantity\u5408\u8ba1\uff09\n3. \u7528\u4ee5\u4e0bSQL\u67e5\u8be2Gaofang V2\u6570\u636e\u5e93\uff1a\n\n```\nsu - postgres -c \"psql -d gaofang_v2 -c \\\"\nWITH upload AS (\n  SELECT \n    to_char(created_at::date, 'YYYY-MM') AS \u6708\u4efd,\n    COUNT(DISTINCT patient_name || '|' || age::text || '|' || COALESCE(patient_phone, '')) AS \u4e0a\u4f20\u60a3\u8005\u4eba\u6570,\n    SUM(quantity) AS \u4e0a\u4f20\u603b\u6599\u6570\n  FROM prescription_records\n  WHERE created_at >= '\u3010\u4e0a\u67081\u53f7\u3011' AND created_at < '\u3010\u672c\u67081\u53f7\u3011'\n    AND created_at IS NOT NULL\n  GROUP BY \u6708\u4efd\n),\ndispense AS (\n  SELECT \n    to_char(created_at::date, 'YYYY-MM') AS \u6708\u4efd,\n    COUNT(DISTINCT patient_name || '|' || age::text || '|' || COALESCE(patient_phone, '')) AS \u53d1\u653e\u60a3\u8005\u6570,\n    SUM(quantity) AS \u53d1\u653e\u6599\u6570\n  FROM prescription_records\n  WHERE created_at >= '\u3010\u4e0a\u67081\u53f7\u3011' AND created_at < '\u3010\u672c\u67081\u53f7\u3011'\n    AND created_at IS NOT NULL\n    AND status IN ('\u5df2\u53d6', '\u5df2\u90ae\u5bc4')\n  GROUP BY \u6708\u4efd\n)\nSELECT \n  COALESCE(u.\u6708\u4efd, d.\u6708\u4efd) AS \u6708\u4efd,\n  COALESCE(u.\u4e0a\u4f20\u60a3\u8005\u4eba\u6570, 0) AS \u4e0a\u4f20\u60a3\u8005\u4eba\u6570,\n  COALESCE(u.\u4e0a\u4f20\u603b\u6599\u6570, 0) AS \u4e0a\u4f20\u603b\u6599\u6570,\n  COALESCE(d.\u53d1\u653e\u60a3\u8005\u6570, 0) AS \u53d1\u653e\u60a3\u8005\u6570,\n  COALESCE(d.\u53d1\u653e\u6599\u6570, 0) AS \u53d1\u653e\u6599\u6570\nFROM upload u\nFULL OUTER JOIN dispense d ON u.\u6708\u4efd = d.\u6708\u4efd\nORDER BY \u6708\u4efd;\n\\\"\n```\n\n4. \u5c06\u7ed3\u679c\u6574\u7406\u6210\u8868\u683c\u683c\u5f0f\u8f93\u51fa\n\n\u6ce8\u610f\uff1a\n- \u5982\u679c\u672c\u6708\u662f1\u6708\uff0c\u4e0a\u4e2a\u6708\u662f\u53bb\u5e7412\u6708\uff0c\u65e5\u671f\u8981\u8de8\u5e74\n- \u5982\u5f53\u6708\u65e0\u6570\u636e\uff0c\u8fd4\u56de\"\u6682\u65e0\u6570\u636e\"\n- 3\u6708\u5305\u542b\u7cfb\u7edf\u521d\u59cb\u5bfc\u5165\u7684\u5386\u53f2\u5168\u91cf\u6570\u636e\uff0c\u9700\u5907\u6ce8\u8bf4\u660e",
