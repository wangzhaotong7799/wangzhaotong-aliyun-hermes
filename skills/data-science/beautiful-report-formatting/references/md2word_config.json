{
  "document": {
    "default_font": "微软雅黑",
    "max_image_width_inches": 5.5,
    "page_margins_inches": {
      "top": 1.0, "bottom": 1.0,
      "left": 1.2, "right": 1.0
    }
  },
  "styles": {
    "heading_1": {
      "font_name": "微软雅黑", "font_size": 22, "bold": true,
      "alignment": "left", "color": "1A365D",
      "space_before": 24, "space_after": 12,
      "numbering_format": "chapter"
    },
    "heading_2": {
      "font_name": "微软雅黑", "font_size": 16, "bold": true,
      "alignment": "left", "color": "2B6CB0",
      "space_before": 18, "space_after": 8,
      "numbering_format": "arabic"
    },
    "heading_3": {
      "font_name": "微软雅黑", "font_size": 13, "bold": true,
      "alignment": "left", "color": "2C5282",
      "space_before": 12, "space_after": 6
    },
    "body": {
      "font_name": "微软雅黑", "font_size": 10.5,
      "alignment": "justify",
      "line_spacing_rule": "multiple", "line_spacing_value": 1.35,
      "space_after": 6
    },
    "code": {
      "font_name": "Consolas", "font_size": 8.5,
      "background_color": "F7FAFC"
    }
  },
  "table": {
    "border_style": "single", "border_color": "CBD5E0", "border_width": 4,
    "header_background_color": "2B6CB0", "header_font_color": "FFFFFF",
    "alternating_row_color": "F7FAFC",
    "cell_padding_top": 3, "cell_padding_bottom": 3,
    "cell_padding_left": 6, "cell_padding_right": 6,
    "width_mode": "full"
  },
  "blockquote": {
    "left_border_color": "3182CE", "left_border_width": 4,
    "background_color": "EBF8FF", "font_style": "italic",
    "font_color": "2D3748"
  },
  "toc": { "enabled": true, "title": "目录", "max_level": 3 }
}
