# ============================
# Hermes Agent — .gitignore
# 仓库用于 git clone 即用，排除运行时生成的垃圾
# ============================

# --- 敏感信息（绝不上传）---
.env
auth.json

# --- 虚拟环境（1GB+，每台机器重新 pip install）---
hermes-agent/venv/
hermes-agent/.venv/
hermes-agent/__pycache__/
hermes-agent/*.egg-info/

# --- 运行时数据库（自动生成）---
state.db
state.db-shm
state.db-wal
response_store.db
response_store.db-shm
response_store.db-wal
kanban.db

# --- 会话历史和记忆（不需要同步历史聊天记录）---
sessions/
memories/
checkpoints/

# --- 缓存文件 ---
cache/
image_cache/
images/
audio_cache/
*.cache.json
models_dev_cache.json
ollama_cloud_models_cache.json

# --- Node.js（200MB+，新机器重新安装）---
node/
node_modules/

# --- 日志 ---
logs/
*.log
interrupt_debug.log

# --- 沙箱和临时文件 ---
sandboxes/
pastes/
pastes/

# --- Python 缓存 ---
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# --- 系统文件 ---
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# --- 网关锁文件（运行时生成，无需同步）---
gateway.lock
gateway.pid

# --- 历史记录（本地 shell 历史）---
.hermes_history

# --- 钩子（本地配置）---
hooks/

# --- 配对文件（临时）---
pairing/

# --- 其他运行时文件 ---
feishu_seen_message_ids.json
.panel_last_session.json
.update_check

# --- 备份文件 ---
*.backup
*.backup.*

# --- 技能运行时缓存 ---
skills/.bundled_manifest
skills/.curator_state
skills/.hub/
skills/.usage.json
.skills_prompt_snapshot.json

# --- 锁文件 ---
*.lock
cron/.tick.lock
